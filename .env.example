# ==============================================================================
# KisanMitra AI - Environment Configuration Template
# Copy this file to '.env' and fill in your values:
# cp .env.example .env
# Never commit the actual '.env' file to Git!
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Device Configuration for Model Inference (cpu, cuda, mps)
# For Apple Silicon Mac: mps | For NVIDIA GPU: cuda | Default fallback: cpu
DEVICE=cpu

# Data.gov.in / Agmarknet API Key (Optional if using direct Agmarknet scraping/CSV)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Open-Meteo Weather API (Free for non-commercial use, key optional)
OPEN_METEO_API_KEY=

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=kisanmitra_experiments

# Storage Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_DIR=./models
REPORTS_DIR=./reports
